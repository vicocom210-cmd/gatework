# Nusxa oling:  cp .env.example .env   — va qiymatlarni o'zgartiring.
# MUHIM: .env faylni hech qachon GitHub'ga yuklamang (u .gitignore'da).

# Sayt domeni (DNS'da A yozuvi serveringiz IP'siga qarashi kerak)
DOMAIN=gatework.uz

DJANGO_DEBUG=0
# Yangi kalit yaratish:  python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=bu-yerga-uzun-tasodifiy-kalit
DJANGO_ALLOWED_HOSTS=gatework.uz,www.gatework.uz
DJANGO_CSRF_TRUSTED_ORIGINS=https://gatework.uz,https://www.gatework.uz

# PostgreSQL paroli (docker-compose o'zi DATABASE_URL'ni yasaydi)
POSTGRES_PASSWORD=bu-yerga-kuchli-parol

# "Admin bilan bog'lanish" menyusi (bo'sh qoldirilsa — ko'rinmaydi)
CONTACT_TELEGRAM=
CONTACT_EMAIL=

# Ixtiyoriy
PAYMENT_CARD=
GOOGLE_CLIENT_ID=509245131008-kib34dra6sb7djvqjqjh85ac9ucma0av.apps.googleusercontent.com
GUNICORN_WORKERS=3
GUNICORN_THREADS=8
